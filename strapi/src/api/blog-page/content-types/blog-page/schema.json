{
  "kind": "singleType",
  "collectionName": "blog_pages",
  "info": {
    "singularName": "blog-page",
    "pluralName": "blog-pages",
    "displayName": "Blog Page",
    "description": "Blog listing page configuration"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "hero": {
      "type": "dynamiczone",
      "components": [
        "sections.hero-section"
      ]
    },
    "featuredPosts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog.blog"
    },
    "postsPerPage": {
      "type": "integer",
      "default": 12,
      "required": false
    }
  }
}
