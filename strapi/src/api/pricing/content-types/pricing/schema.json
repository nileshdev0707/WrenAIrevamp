    },
    "ctaPrimaryUrl": {
      "type": "string"
    },
    "ctaSecondaryLabel": {
      "type": "string"
    },
    "ctaSecondaryUrl": {
      "type": "string"
    },
    "TrustedBy": {
      "type": "dynamiczone",
      "components": [
        "sections.logos-section"
      ]
    },
    "ContentBlock": {
      "type": "dynamiczone",
      "components": [
        "shared.content-block"
      ]
    },
